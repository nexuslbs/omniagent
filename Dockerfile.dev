# syntax=docker/dockerfile:1
# OmniAgent: Development environment image
# Rust toolchain + dev tooling. No code is built here; run builds
# manually via docker compose exec or the scripts/build.py entry point.

FROM docker:cli AS docker-cli

FROM rust:1.96.0
WORKDIR /app

# Copy Docker CLI + compose plugin for integration tests
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

# Rust dev components (fast: no compilation, just downloads)
RUN rustup component add rustfmt clippy

# cargo-expand: expand macros (debugging)
RUN cargo install cargo-expand --locked

# Install sqlx-cli for offline query cache generation (pre-built binary, no compilation)
RUN cargo install sqlx-cli --locked

# Dev tooling: nodejs + npm (test-js-tool MCP server, NodeJS reference MCP servers),
# python3 + pip + venv (Python plugins/reference servers, hermetic install;
# scripts/build.py; prepare.py lives in omni-deployer).
# legacy-peer-deps global: MCP reference servers ship zod v4 peer deps that
# strict npm resolution rejects (observed on mcp-everything install); makes
# installs robust on reinstall.
RUN apt-get update -qq && apt-get install -y -qq nodejs npm python3 python3-pip python3-venv && \
    npm config set legacy-peer-deps true && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# psycopg2: integration tests (tests.py) read DB rows directly (workflow tests)
# python3-yaml: integration tests read config yml files (settings.yml)
# Debian package (PEP 668 blocks bare pip on python3.13)
RUN apt-get update -qq && apt-get install -y -qq python3-psycopg2 python3-yaml && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Trust all repos under /opt/workspace (container mounts host git repos)
# * also covers /opt/omni/.git-cache/* created by install-git API clone
RUN git config --global safe.directory '*' \
    && git config --global --add safe.directory /opt/workspace/omni-stack/.git \
    && git config --global --add safe.directory /opt/workspace/omni-plugins/.git \
    && git config --global --add safe.directory /opt/workspace/omni-dashboard/.git \
    && git config --global --add safe.directory /opt/workspace/omniagent/.git

# Keep the container alive; no code builds here.
# Run builds manually: docker compose exec omniagent cargo build --release -p omniagent
# Or use the build script: docker compose exec omniagent python3 /app/scripts/build.py
CMD exec tail -f /dev/null
