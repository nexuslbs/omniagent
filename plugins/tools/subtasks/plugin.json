{
  "name": "Subtasks MCP Server",
  "id": "mcp-server-subtasks",
  "version": "0.1.0",
  "description": "Thread subtask management: add, list, update, delete, count subtasks",
  "type": "mcp",
  "entrypoint": {
    "command": "mcp-server-subtasks",
    "args": [],
    "transport": "stdio"
  },
  "config_schema": [
    {
      "key": "database_url",
      "label": "Database URL",
      "type": "string",
      "default": "$env:DATABASE_URL",
      "description": "PostgreSQL connection URL for subtask storage"
    }
  ],
  "tools": [
    { "name": "manage_subtasks", "behavior": { "family": "subtasks" } },
    { "name": "add_subtask", "behavior": { "family": "subtasks" } },
    { "name": "update_subtask", "behavior": { "family": "subtasks" } },
    { "name": "delete_subtask", "behavior": { "family": "subtasks" } },
    { "name": "list_subtasks", "behavior": { "read_only": true, "repeat_guard": false, "family": "subtasks" } }
  ]
}
