{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id, role, content, msg_type, msg_subtype,\n                thread_id, thread_sequence,\n                COALESCE(TO_CHAR(created_at, 'YYYY-MM-DD\"T\"HH24' || CHR(58) || 'MI' || CHR(58) || 'SS.US\"Z\"'), '') AS \"created_at\"\n            FROM messages\n            WHERE thread_id = $1\n            ORDER BY thread_sequence ASC, created_at ASC\n            LIMIT $2\n            ",
