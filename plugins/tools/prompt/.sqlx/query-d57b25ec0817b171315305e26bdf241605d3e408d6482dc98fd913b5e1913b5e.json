{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, status, iterations,\n               TO_CHAR(ended_at, 'YYYY-MM-DD HH24' || CHR(58) || 'MI') AS ended_at\n        FROM threads\n        WHERE task_id = $1\n          AND (task_type = 'kanban' OR task_type IS NULL)\n          AND id < $2\n        ORDER BY id DESC\n        LIMIT $3\n        ",
