  "query": "\n        SELECT t.id, t.status\n        FROM messages m\n        JOIN threads t ON t.id = m.thread_id\n        WHERE m.external_id = $1\n          AND m.thread_sequence = 0\n          AND t.channel_id = $2\n        LIMIT 1\n        ",
