{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id, title, body, status, priority, position, assignee,\n            channel_id, profile, archived, template, toolset, plan, workflow_id, board,\n            thread_status,\n            COALESCE((\n                SELECT jsonb_agg(kt.name ORDER BY kt.name)\n                FROM task_tags tt\n                JOIN kanban_tags kt ON kt.id = tt.tag_id\n                WHERE tt.task_id = kanban_tasks.id\n            ), '[]'::jsonb) AS tags_json,\n            created_at, updated_at\n        FROM kanban_tasks\n        WHERE id = $1\n        ",
