  "query": "SELECT t.id, t.status FROM threads t\n                   JOIN messages m ON m.thread_id = t.id AND m.thread_sequence = 0\n                   WHERE t.task_id = $1 AND t.workflow_step = $2\n                     AND m.external_id LIKE $3\n                   ORDER BY t.id LIMIT 1",
