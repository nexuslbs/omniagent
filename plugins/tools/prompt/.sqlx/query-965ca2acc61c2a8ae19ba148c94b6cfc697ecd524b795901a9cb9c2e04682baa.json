{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            d.task_id AS id,\n            t.title,\n            t.status,\n            t.board,\n            t.priority,\n            t.archived,\n            t.created_at\n        FROM kanban_task_dependencies d\n        JOIN kanban_tasks t ON t.id = d.task_id\n        WHERE d.depends_on_id = $1\n        ORDER BY t.priority ASC, t.created_at DESC\n        ",
