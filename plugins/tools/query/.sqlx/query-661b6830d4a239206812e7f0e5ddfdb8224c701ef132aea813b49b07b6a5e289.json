  "query": "\n        SELECT t.id, t.status\n        FROM kanban_tasks t\n        WHERE t.status IN ('running', 'testing', 'review')\n          AND NOT EXISTS (\n              SELECT 1 FROM threads th\n              WHERE th.task_id = t.id AND th.status IN ('pending', 'processing')\n          )\n        ",
