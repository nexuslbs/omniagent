{
  "name": "git",
  "label": "git",
  "version": "0.1.0",
  "type": "mcp",
  "description": "Git/GitHub operations \u2014 create repos, clone, commit, push, status",
  "config_schema": [
    {
      "key": "omni_dir",
      "default": "$env:OMNI_DIR",
      "label": "Omni Dir",
      "type": "string"
    },
    {
      "key": "workspace_dir",
      "default": "/opt/workspace",
      "label": "Workspace Dir (sandbox - git actions only allowed here and in subdirectories)",
      "type": "string",
      "required": false
    },
    {
      "key": "allow_omni_dir",
      "default": true,
      "label": "Allow git operations in the omni_dir repo (default true)",
      "type": "boolean",
      "required": false
    },
    {
      "key": "github_app_token",
      "label": "GitHub App Token (legacy static token)",
      "type": "string",
      "required": false
    },
    {
      "key": "github_app_private_key",
      "label": "GitHub App Private Key (PEM)",
      "type": "string",
      "required": false
    },
    {
      "key": "github_app_id",
      "label": "GitHub App ID",
      "type": "string",
      "required": false
    },
    {
      "key": "github_installation_id",
      "label": "GitHub Installation ID",
      "type": "string",
      "required": false
    }
  ],
  "entrypoint": {
    "command": "mcp-server-git",
    "args": [],
    "transport": "stdio"
  }
}