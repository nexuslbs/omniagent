{
  "name": "git",
  "label": "git",
  "version": "0.1.0",
  "type": "mcp",
  "description": "Git/GitHub operations \u2014 create repos, clone, commit, push, status",
  "config_schema": [
    {
      "key": "omni_dir",
      "default": "$env:OMNI_DIR",
      "label": "Omni Dir",
      "type": "string"
    },
    {
      "key": "workspace_dir",
      "default": "$env:WORKSPACE_DIR",
      "label": "Workspace Dir",
      "type": "string",
      "required": false
    },
    {
      "key": "github_app_id",
      "default": "$env:GITHUB_APP_ID",
      "label": "GitHub App ID",
      "type": "string",
      "required": false
    },
    {
      "key": "github_installation_id",
      "default": "$env:GITHUB_INSTALLATION_ID",
      "label": "GitHub Installation ID",
      "type": "string",
      "required": false
    }
  ],
  "entrypoint": {
    "command": "mcp-server-git",
    "args": [],
    "transport": "stdio"
  }
}