# omni-stack .gitignore
# Allow everything by default; only exclude build artifacts, env files, and secrets.

# ── Build artifacts ──
target/
node_modules/
dist/

# ── Environment / secrets ──
.env
.env.*.local
.env.bak
.env.cron

# ── Temporary / generated files ──
COMMIT_MSG.txt

# ── Git plugin cache (shared bare mirrors for remote plugin clones) ──
.git-cache/
*.bak
scripts/*
!scripts/
!scripts/prepare.py
!scripts/build.py
docs/

# ── Runtime test artifacts (created by tests.py) ──
plugins/tools/test-python-tool/

# ── OS files ──
.DS_Store
Thumbs.db

# ── Runtime-only: temp, logs ──
*.log
tmp/

# Eliminated struct: workspace root, each plugin has own Cargo.toml
/Cargo.toml

# ── Data dir (runtime-only: research, generated content) ──
/data/
plugins/mcp/.remote/
plugins/tools/.remote/
plugins/.remote/

# Broken env-var expansion artifacts (scripts that don't properly expand ${VAR})
**/\${*

# Compiled binaries
/omniagent
/omniagent.new
/mcp-server-*
plugins/tools/*/mcp-server-*

# smoke-test / task scratch artifacts: NEVER commit these
.g46-omni/
.g46dbg/
.smoke-*/
.taskj-*
.taskk-*
.taskl-*
.taskm-*.py
.taskm-*.patch
.task*.patch
patch_clobber.py
*.rej
*.orig
*_mod*.py

!scripts/lint-core-platform-boundary.py

# ─────────────────────────────────────────────
# Never-commit secret guardrails (code-plan C9)
# ─────────────────────────────────────────────
# Real env files and secret material must never be committed. Commit only
# the *.env.example / *.sample / *.dist placeholder templates (see
# scripts/secret-scan.py; pre-commit hook + CI job enforce this).
.env
.env.*
!.env.example
!.env.sample
!.env.dist
*.env
!*.env.example
!*.env.sample
!*.env.dist
config.yml
config.local.yml
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.jks
*.keystore
*.secret
*.credential
secrets.env
secrets.env.*
id_rsa
id_ecdsa
id_ed25519

# Re-include the C9 scanner + installer (repo .gitignore ignores scripts/*)
!scripts/secret-scan.py
!scripts/install-pre-commit-secret-scan.sh

# ─────────────────────────────────────────────
# Never-commit secret guardrails, part 2 (external-plan X7): Playwright
# per-site session state and secrets files. A storage-state file carries LIVE
# cookies + localStorage for a logged-in site; a --secrets file carries the
# typed credential values. Neither may be committed - share a session through
# the secrets store instead (see the web-interaction skill).
# ─────────────────────────────────────────────
**/*storage-state*.json
**/*storage_state*.json
**/*storageState*.json
**/*.auth.json
**/sessions.json
**/playwright-secrets.*
**/pw-secrets.*
!scripts/test_secret_scan.py

# Python bytecode caches (generated by test harnesses / imports)
__pycache__/
*.pyc
!scripts/test_lint_core_platform_boundary.py
