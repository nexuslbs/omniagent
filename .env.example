# omniagent - local environment template (code-plan C9 never-commit guardrail)
#
# Copy this file to `.env` (gitignored) and fill in REAL values for local
# development. NEVER commit `.env` or any file holding live secrets - the
# pre-commit hook and CI job (scripts/secret-scan.py) block them.
# Real secrets live only in the deployer secrets.env / the agent secrets
# store and are referenced as $env:VAR / $secret:NAME, never in a repo.
#
# All values below are placeholders (xxxx). Replace every xxxx before use.
RUST_LOG=info
DEEPSEEK_API_KEY=xxxx-your-deepseek-api-key
DATABASE_URL=postgres://omni:xxxx@localhost:5432/omni
GITHUB_APP_ID=xxxx
GITHUB_APP_INSTALLATION_ID=xxxx
