# omniagent - local environment template (code-plan C9 never-commit guardrail)
#
# Copy this file to `.env` (gitignored) and fill in REAL values for local
# development. NEVER commit `.env` or any file holding live secrets - the
# pre-commit hook and CI job (scripts/secret-scan.py) block them.
# Real secrets live only in the deployer secrets.env / the agent secrets
# store and are referenced as $env:VAR / $secret:NAME, never in a repo.
#
# All values below are placeholders (xxxx). Replace every xxxx before use.
RUST_LOG=info
DEEPSEEK_API_KEY=xxxx-your-deepseek-api-key
DATABASE_URL=postgres://omni:xxxx@localhost:5432/omni
GITHUB_APP_ID=xxxx
GITHUB_APP_INSTALLATION_ID=xxxx

# --- external-plan X7: new credential classes (never commit) ---------------
# Values for these credential classes live ONLY in the secrets store or in an
# untracked .env file. Committing them is blocked by scripts/secret-scan.py and
# .gitleaks.toml (see the session-state / credentials guidance in .gitignore).
#   EMAIL_APP_PASSWORD=<app password>     himalaya password / password.command value
#   MODEM_SIM_PIN=<SIM PIN>               SMS modem / SIM PIN
#   TWILIO_ACCOUNT_SID=<account SID>      Twilio account SID (AC...)
#   TWILIO_API_KEY=<API key SID>          Twilio API key SID (SK...)
#   TWILIO_AUTH_TOKEN=<auth token>        Twilio auth token
#   TOTP_SECRET=<base32 secret>           TOTP/HOTP shared secret
#   PLAYWRIGHT_STORAGE_STATE=<file path>  per-site session file - never committed
