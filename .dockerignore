# Exclude Dockerfiles from the build context so changing them doesn't
# invalidate the COPY . . cache layer in the builder stage, which would
# trigger a full cargo workspace rebuild.
Dockerfile
Dockerfile.dev

# Standard exclusions
.git/
.gitignore
node_modules/
**/node_modules/
docs/
skills/
data/
target/
**/target/
*.zip
Vagrantfile

# Stray committed build artifacts (binary files checked into git by
# mistake — entrypoints resolve via PATH to /usr/local/bin/, so these
# are never used at runtime). Excluding them shrinks the build context
# by ~300MB and the runtime image by the same.
mcp-server-prompt
**/mcp-server-prompt
**/mcp-server-*
**/*-platform
