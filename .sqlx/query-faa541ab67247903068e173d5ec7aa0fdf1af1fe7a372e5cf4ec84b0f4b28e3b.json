{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE hooks SET\n            name = COALESCE(NULLIF($1, ''), name),\n            display_name = COALESCE(NULLIF($2, ''), display_name),\n            event = COALESCE(NULLIF($3, ''), event),\n            scope = COALESCE(NULLIF($4, ''), scope),\n            target = NULLIF($5, ''),\n            count = COALESCE($6, count),\n            mode = COALESCE(NULLIF($7, ''), mode),\n            prompt = COALESCE(NULLIF($8, ''), prompt),\n            action_id = COALESCE(NULLIF($9, ''), action_id),\n            profile = COALESCE(NULLIF($10, ''), profile),\n            channel_id = NULLIF($11, 0::bigint),\n            planning_mode = NULLIF($12, ''),\n            plan = COALESCE($13, plan),\n            template = COALESCE(NULLIF($14, ''), template),\n            enabled = COALESCE($15, enabled),\n            updated_at = NOW()\n        WHERE id = $16\n        RETURNING\n            id, name, display_name, event, scope, target,\n            counter::text AS counter, count, mode,\n            prompt, action_id, profile, channel_id, planning_mode, plan, template, enabled,\n            COALESCE(TO_CHAR(created_at, 'YYYY-MM-DD\"T\"HH24' || CHR(58) || 'MI' || CHR(58) || 'SS.US\"Z\"'), '') AS \"created_at\",\n            COALESCE(TO_CHAR(updated_at, 'YYYY-MM-DD\"T\"HH24' || CHR(58) || 'MI' || CHR(58) || 'SS.US\"Z\"'), '') AS \"updated_at\"\n        ",
