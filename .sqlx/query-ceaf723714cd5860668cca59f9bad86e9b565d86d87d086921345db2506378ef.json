{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id AS thread_id, m.content AS content\n        FROM messages m\n        JOIN threads t ON t.id = m.thread_id\n        WHERE t.channel_id = $1\n          AND m.role = 'cause'\n          AND t.id < $2\n        ORDER BY m.id DESC\n        LIMIT $3\n        ",
